# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey (hearing, thinking, speaking).
GOOGLE_API_KEY=
# Your domain, pointed at the server (needed for HTTPS and the microphone).
DOMAIN=order.example.com
# Long random secrets. Generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
AGENT_API_KEY=
ADMIN_TOKEN=

# --- Restaurant -------------------------------------------------------------
RESTAURANT_NAME=رستوران نمونه هرات
DELIVERY_FEE_AFN=50
ETA_MINUTES=40
# Insert the sample Herat menu when the menu table is empty.
SEED_SAMPLE_MENU=true

# --- Telegram alerts (optional; without them orders are only logged) ---------
# Create a bot with @BotFather, add it to the restaurant's group, then read the
# group's chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp calling (optional; see docs/whatsapp.md) -----------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=

# --- Models (defaults are fine; change only to experiment) ------------------
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_LLM_MODEL=gemini-3.6-flash
# gemini-3.6-flash accepts minimal; 3.7/3.8 Flash need low or higher.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Empty = automatic detection. Set e.g. fa-AF,en-US to give hints instead.
STT_LANGUAGES=
# Empty = the voice model detects Dari from the text.
TTS_LANGUAGE=

# --- Cost estimates in the dashboard (US dollars, list prices Oct 2026) -----
COST_LLM_INPUT_PER_M=0.75
COST_LLM_OUTPUT_PER_M=3.75
COST_STT_PER_MIN=0.009
COST_TTS_PER_M_AUDIO=6

# --- Limits so a public call page cannot run up the bill --------------------
MAX_CONCURRENT_CALLS=5
MAX_CALL_SECONDS=600
